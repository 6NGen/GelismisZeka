# Google Gemini API anahtarı — YALNIZ sunucuda okunur, istemciye asla sızmaz.
# NEXT_PUBLIC_ öneki ASLA eklenmemelidir.
# Anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Opsiyonel: analiz çağrılarında kullanılacak model.
# Varsayılan: gemini-2.5-flash
GZ_MODEL=gemini-2.5-flash

# ── Kota koruması (hepsi opsiyonel) ────────────────────────────────
# Günlük toplam model çağrısı tavanı. Bir analiz 4 çağrıdır.
# 200 ≈ günde 50 analiz. 0 vermek canlı analizi tamamen kapatır.
GZ_DAILY_CALL_CAP=200

# IP başına saatlik istek tavanı. 20 ≈ saatte 5 analiz.
GZ_RATE_LIMIT=20

# Sunucu sonuç önbelleğinin ömrü (saat). Aynı mevzu bu süre içinde
# tekrar sorulursa modele hiç gidilmez.
GZ_CACHE_TTL_HOURS=24
